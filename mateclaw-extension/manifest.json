{
  "manifest_version": 3,
  "name": "化帆AI 浏览器助手",
  "version": "0.1.13",
  "description": "MateClaw Browser Agent — Phase 1 connectivity",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "128": "icon-128.png" },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": { "default_title": "Open MateClaw" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "nativeMessaging",
    "scripting",
    "webNavigation",
    "debugger",
    "offscreen",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": [
      "http://localhost:18088/*",
      "http://localhost:5173/*",
      "http://localhost:18080/*",
      "http://127.0.0.1:18088/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:18080/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/a11y-tree.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/visual-indicator.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:18077 ws://localhost:18077 ws://localhost:18088 ws://127.0.0.1:18088 ws://localhost:5173 ws://127.0.0.1:5173 ws://localhost:18080 ws://127.0.0.1:18080 wss://localhost:18088 wss://127.0.0.1:18088 wss://*"
  }
}
